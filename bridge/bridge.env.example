# Keryx bridge settings. install.sh copies this file to ~/.config/keryx/bridge.env (mode 600) and generates the
# token; fill in the keys there. The process environment overrides anything set here.

# --- required -------------------------------------------------------------------------------------------------
# xAI API key (https://console.x.ai): streaming speech-to-text and text-to-speech.
XAI_API_KEY=
# Hermes' API server key: API_SERVER_KEY in ~/.hermes/.env on the Hermes host (with API_SERVER_ENABLED=true).
HERMES_API_KEY=
# Shared secret between the bridge and the board; `keryx-bridge pair` writes it into the board.
KERYX_BRIDGE_TOKEN=

# --- optional -------------------------------------------------------------------------------------------------
# Hermes' OpenAI-compatible API: the same machine by default, any host on the network otherwise.
#HERMES_URL=http://127.0.0.1:8642/v1
# xAI voice: eve, rex, ara, sal, leo and others.
#XAI_VOICE=eve
# Where the board connects: ws://<this machine>:<port>/keryx.
#KERYX_BRIDGE_HOST=0.0.0.0
#KERYX_BRIDGE_PORT=8765
# The voice channel's system prompt, layered by Hermes on top of its own: a file (relative to this one) or text
# (`\n` for line breaks). Default: the bundled keryx_bridge/prompts/voice.md.
#KERYX_SYSTEM_PROMPT_PATH=voice.md
#KERYX_SYSTEM_PROMPT=
