CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# start-up log over the XIAO's USB-C until TinyUSB takes the PHY; UART0 pins 43/44 carry I2S data on this board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# USB Audio Class device
CONFIG_UAC_TUSB_MANUFACTURER="Flopsstuff"
CONFIG_UAC_TUSB_PRODUCT="Keryx"
CONFIG_UAC_TUSB_SERIAL_NUM="keryx-proto"
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_SUPPORT_MACOS=y
# plus a serial port: the log, wake events and commands (keryx_console)
CONFIG_UAC_CDC=y
# USB on core 0; core 1 belongs to the capture task and the wake word
CONFIG_UAC_TINYUSB_TASK_CORE=0
CONFIG_UAC_MIC_TASK_CORE=0
CONFIG_UAC_SPK_TASK_CORE=0
