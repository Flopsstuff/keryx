CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# partitions.csv: two 3 MB app slots and a filesystem
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# start-up log over the XIAO's USB-C until TinyUSB takes the PHY; UART0 pins 43/44 carry I2S data on this board
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# for size; the wake word and its frontend build with -O2 (their CMakeLists), where the time goes
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# USB Audio Class device
CONFIG_UAC_TUSB_MANUFACTURER="Flopsstuff"
CONFIG_UAC_TUSB_PRODUCT="Keryx"
CONFIG_UAC_TUSB_SERIAL_NUM="keryx-proto"
CONFIG_UAC_SAMPLE_RATE=48000
CONFIG_UAC_BIT_RESOLUTION_16=y
CONFIG_UAC_MIC_CHANNEL_NUM=2
CONFIG_UAC_SPEAKER_CHANNEL_NUM=2
CONFIG_UAC_SUPPORT_MACOS=y
# plus a serial port: the log, wake events and commands (keryx_console)
CONFIG_UAC_CDC=y
# USB on core 0; core 1 belongs to the capture task and the wake word
CONFIG_UAC_TINYUSB_TASK_CORE=0
CONFIG_UAC_MIC_TASK_CORE=0
CONFIG_UAC_SPK_TASK_CORE=0

# The XIAO's 8 MB octal PSRAM: Wi-Fi, lwIP and the large audio buffers go there, leaving internal RAM to the wake
# word's weights (which must stay there for speed) and small allocations
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Internal RAM is short (the wake word's weights take 118 KB of it), and Wi-Fi needs its RX buffers there: keep code
# in flash rather than IRAM where speed does not matter. Our stream is ~32 KB/s.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# allocations above 2 KB go to PSRAM (default 16 KB): the WebSocket client's buffers among them
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
# tasks that never write flash may keep their stacks in PSRAM (xTaskCreate...WithCaps)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
# sending the uplink must not wait while the receive side holds back the bridge's audio
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
# USB audio runs every 1 ms and briefly; above lwIP (18), or Wi-Fi traffic starves it. lwIP stays on core 0 with
# Wi-Fi, leaving core 1 to capture and playback.
CONFIG_UAC_TINYUSB_TASK_PRIORITY=20
CONFIG_UAC_MIC_TASK_PRIORITY=20
CONFIG_UAC_SPK_TASK_PRIORITY=20
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
